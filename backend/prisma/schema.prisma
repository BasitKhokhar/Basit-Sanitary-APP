generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Notification {
  id          Int      @id @default(autoincrement())
  userId      Int?                                 // null if it's a global (admin broadcast)
  title       String   @db.VarChar(255)
  message     String   @db.Text
  type        String   @default("system")          // e.g. "system", "admin", "image_generated"
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        users?   @relation("UserNotifications", fields: [userId], references: [user_id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}


model sliderimages {
  id              Int    @id @default(autoincrement())
  sliderimage_url String @db.VarChar(255)
}

model userimages {
  id         Int      @id @default(autoincrement())
  user_id    Int      @unique
  image_url  String   @db.VarChar(512)
  created_at DateTime @default(now()) @db.Timestamp(0)
  users      users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, map: "userimage_ibfk_1")

  @@index([user_id], map: "user_id")
}

model users {
  user_id      Int                  @id @default(autoincrement())
  name         String               @db.VarChar(100)
  email        String               @unique(map: "email") @db.VarChar(100)
  password     String               @db.VarChar(255)
  phone        String?              @db.VarChar(20)
  termsStatus  Boolean              @default(false)
  refreshToken String? 
  created_at   DateTime             @default(now()) @db.DateTime(0)

  userimages   userimages[]
  generated    UserGeneratedImage[]
  favourites   UserFavouriteTemplate[]
  
  // ✅ Add this reverse relation:
  notifications Notification[]      @relation("UserNotifications")
}


model Apppdffiles {
  id    Int    @id @default(autoincrement())
  title String
  url   String
}

model FAQ {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
